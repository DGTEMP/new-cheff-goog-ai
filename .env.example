# ======================================================
#  CHEF COZINHA - Modelo de configuracao (.env.example)
#  Copie para ".env" e preencha antes de subir o servidor.
# ======================================================

# Segredo usado para assinar os tokens JWT (sessoes).
# Gere um aleatorio com: openssl rand -hex 32
JWT_SECRET=troque-por-um-valor-aleatorio-com-64-hex

# Origem(s) permitida(s) no CORS (o endereco que o cliente acessa).
# Vazio/omitido = aceita qualquer origem.
# CORS_ORIGIN=https://chef.minhadominio.com.br
CORS_ORIGIN=

# URL do Apps Script usada para validar a licenca.
# LICENSE_URL=https://script.google.com/macros/s/SEU_ID_DE_CONFIG/exec

# URL do servidor Hub (usado pelo license-manager).
# CHEF_HUB_URL=https://hub.minhadominio.com.br

# Segredo de autenticacao do suporte/atendimento.
# SUPORTE_JWT_SECRET=

# Diretorio de dados (usado por server-prod-header.js).
# CHEF_DATA_DIR=/var/lib/chefcozinha
